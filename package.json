{
  "name": "baseline-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Baseline / BaseManager irrigation controller system (baselineapps.net)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "baseline-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "mcp-check": "npm run build && node --import tsx scripts/mcp-check.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fast-xml-parser": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
