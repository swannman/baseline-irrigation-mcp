# Credentials for baselineapps.net (BaseManager).
# Copy to .env (gitignored) or pass these via your MCP client config's "env" block.
BASELINE_USERNAME=your-username
BASELINE_PASSWORD=your-password

# Multi-org / multi-controller accounts (optional).
# Some accounts can access several Baseline organizations and controllers.
# Pin defaults so tools don't need explicit ids each call:
# BASELINE_COMPANY_ID=         # restrict enumeration to one organization
# BASELINE_CONTROLLER_ID=      # default controller when a tool omits controllerId

# Optional overrides:
# BASELINE_BASE_URL=https://baselineapps.net
# BASELINE_TIMEOUT_MS=30000
